# PostgreSQL — copier vers backend/.env
# Neon : collez l'URL avec ?sslmode=require (retirée automatiquement pour asyncpg + SSL activé)
# Vercel : préférer l'URL « pooler » Neon (host *-pooler.*.neon.tech) pour le serverless
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=dev-secret-key-change-me
COOKIE_SECURE=false
COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:5173
APP_NAME=Assistant AI
ENVIRONMENT=development

# Logging — LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# SQL_ECHO=true : requêtes SQL (echo SQLAlchemy ; détail pool si LOG_LEVEL=DEBUG)
LOG_LEVEL=DEBUG
SQL_ECHO=true

# Brevo (e-mails transactionnels) — https://www.brevo.com/
# BREVO_API_KEY=xkeysib-xxxx
# Adresse « From » validée dans l'espace Brevo
# BREVO_SENDER_EMAIL=noreply@votre-domaine.fr
# (aussi destinataire des alertes debug Gemini parse error)
# BREVO_SENDER_NAME=Assistant AI
# true = tests : envoi uniquement vers BREVO_SANDBOX_RECIPIENT (ou logs si vide)
BREVO_USE_SIMULATION=true
# BREVO_SANDBOX_RECIPIENT=votre-email@test.com
EMAIL_VERIFY_EXPIRE_HOURS=48

# Google Gemini — legacy (לא בשימוש אם OpenCode Go מוגדר)
# חובה גם ב-Vercel: Settings → Environment Variables → GEMINI_API_KEY (Production + Preview)
GEMINI_API_KEY=
# רשימת מודלים: GET https://generativelanguage.googleapis.com/v1beta/models?key=...
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_GENERATION_FALLBACK_MODELS=gemini-2.0-flash,gemini-2.5-flash-lite
GEMINI_RETRY_COUNT=2
GEMINI_RETRY_DELAY_SECONDS=2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_GENERATION_MAX_OUTPUT_TOKENS=8192
GEMINI_GENERATION_TIMEOUT_SECONDS=120
# 0 = pas de "thinking" interne (recommandé pour gemini-2.5-flash)
GEMINI_THINKING_BUDGET=0

# OpenCode Go — הסברי תשובות + יצירת שאלות (https://opencode.ai/go)
#
# === Vercel / production (ענן) ===
# 1. Dashboard Vercel → Settings → Environment Variables
# 2. OPENCODE_API_KEY=sk-opencode-... (מ-opencode.ai/go)
# 3. OPENCODE_API_BASE_URL=https://opencode.ai/zen/go/v1 (endpoint OpenCode Go / Zen)
# 4. OPENCODE_MODEL_ID / OPENCODE_GENERATION_MODEL_ID — מודלים מהמנוי (למשל qwen-max, deepseek-v4-flash)
# לא צריך OPENCODE_SERVER_URL על Vercel.
#
# === Dev local (opencode serve) ===
# 1. opencode → /connect → OpenCode Go
# 2. opencode serve --port 4096
# 3. OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_API_KEY ריק → נשתמש ב-serve המקומי.
#
OPENCODE_API_KEY=
OPENCODE_API_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROVIDER_ID=opencode-go
OPENCODE_MODEL_ID=deepseek-v4-flash
OPENCODE_AGENT=build
# Délai max (secondes) pour tous les appels OpenCode — explications + génération prof.
# Ne pas descendre sous 120 : la génération QCM peut prendre ~30–90 s.
OPENCODE_TIMEOUT_SECONDS=120
OPENCODE_RETRY_COUNT=2
OPENCODE_RETRY_DELAY_SECONDS=2
# יצירת שאלות (מורה) — modèle/agent séparés, même timeout
OPENCODE_GENERATION_MODEL_ID=deepseek-v4-flash
OPENCODE_GENERATION_AGENT=build
